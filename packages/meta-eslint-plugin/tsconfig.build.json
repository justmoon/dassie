{
  "extends": "@dassie/meta-tsconfig/base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "noEmitOnError": false,
    "emitDeclarationOnly": false,
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "dist"
  }
}
