{
  "workspace": [
    "./apps/wallet",
    "./packages/identity-wasm",
    "./packages/rpc",
    "./packages/ui",
    "./apps/dev",
    "./apps/dev-dashboard",
    "./apps/website",
    "./tests/e2e",
    "./tests/interop"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "crates/",
    "target/",
    "spec/",
    "testdata/",
    "packages/identity-wasm/gen/",
    "packages/rpc/src/gen/",
    "apps/wallet/dist/",
    "apps/*/dist-dev/",
    "apps/dev-dashboard/dist/",
    "apps/website/dist/"
  ],
  "fmt": {
    "include": [
      "apps/",
      "packages/",
      "tests/",
      "scripts/",
      "deno.json"
    ],
    "exclude": [
      "**/*.md",
      "apps/dev/vanity.json",
      "apps/website/public/"
    ]
  },
  "tasks": {
    "build:wasm": "deno run --allow-run --allow-read --allow-write --allow-env scripts/build-wasm.ts",
    "build:wallet": "cd apps/wallet && deno task build",
    "build:dashboard": "cd apps/dev-dashboard && deno task build",
    "build:website": "cd apps/website && deno task build",
    "build:e2e": "DASSIE_WALLET_DIST=$(pwd)/apps/wallet/dist cargo build --locked --profile e2e -p dassie-cli && cargo build --locked --profile e2e -p dassie-node --features testing --example fake_ledger && cargo build --locked --profile e2e -p dassie-release --features tool",
    "dev": "deno run -A apps/dev/main.ts",
    "cli": "deno run -A apps/dev/cli.ts",
    "check": "deno fmt --check && deno lint && deno check",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys=hostname",
    "ci": "deno task build:wasm && deno task build:wallet && deno task build:dashboard && deno task build:website && deno task build:e2e && deno task check && deno task test"
  }
}
