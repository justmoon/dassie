diff --git a/include/xrpl/consensus/Validations.h b/include/xrpl/consensus/Validations.h
index e4917c9ece..3be7fe5dbc 100644
--- a/include/xrpl/consensus/Validations.h
+++ b/include/xrpl/consensus/Validations.h
@@ -1064,6 +1064,30 @@ public:
         return res;
     }
 
+    /**
+     * Get every validation held for a specific ledger
+     *
+     * Unlike the other accessors, this returns validations whether or not
+     * they are trusted or full, and does not extend how long the ledger's
+     * validations are kept: a caller can read them, but not keep them alive.
+     *
+     * @param ledgerID The identifier of ledger of interest
+     * @return Validations associated with ledger
+     */
+    std::vector<WrappedValidationType>
+    getAllForLedger(ID const& ledgerID)
+    {
+        std::vector<WrappedValidationType> res;
+        std::scoped_lock const lock{mutex_};
+        if (auto const it = byLedger_.find(ledgerID); it != byLedger_.end())
+        {
+            res.reserve(it->second.size());
+            for (auto const& [key, val] : it->second)
+                res.emplace_back(val.unwrap());
+        }
+        return res;
+    }
+
     /**
      * Returns fees reported by trusted full validators in the given ledger
      *
diff --git a/include/xrpl/shamap/SHAMap.h b/include/xrpl/shamap/SHAMap.h
index 9a2b025156..620034c8d9 100644
--- a/include/xrpl/shamap/SHAMap.h
+++ b/include/xrpl/shamap/SHAMap.h
@@ -384,6 +384,29 @@ public:
     static bool
     verifyProofPath(UInt256 const& rootHash, UInt256 const& key, std::vector<Blob> const& path);
 
+    /**
+     * Get the branch from the root towards a key, which proves either that
+     * the key is in the map or that it is not.
+     *
+     * Each node is serialized with its hash prefix, as it is hashed, so the
+     * hash of a node is the SHA-512Half of its blob. The deepest node comes
+     * first and the root last. The deepest node is one of:
+     * - the leaf holding the key, which proves it present;
+     * - the leaf of another key, which stands where the key would be: a leaf
+     *   sits at the shallowest depth at which its key is unique, so the key
+     *   is absent;
+     * - the inner node whose branch towards the key is empty: the key is
+     *   absent.
+     *
+     * An empty map gives an empty branch. Its root hash is zero, which proves
+     * every key absent.
+     *
+     * @param key  key of the leaf
+     * @return the branch, deepest node first
+     */
+    std::vector<Blob>
+    getProofBranch(UInt256 const& key) const;
+
     /**
      * Serializes the root in a format appropriate for sending over the wire
      */
diff --git a/src/libxrpl/shamap/SHAMapSync.cpp b/src/libxrpl/shamap/SHAMapSync.cpp
index d5abd6e484..d894f02b11 100644
--- a/src/libxrpl/shamap/SHAMapSync.cpp
+++ b/src/libxrpl/shamap/SHAMapSync.cpp
@@ -952,4 +952,29 @@ SHAMap::verifyProofPath(UInt256 const& rootHash, UInt256 const& key, std::vector
     return false;
 }
 
+std::vector<Blob>
+SHAMap::getProofBranch(UInt256 const& key) const
+{
+    // An empty inner node has no prefixed form: its hash is zero, not the
+    // hash of sixteen zero branches.
+    if (root_->isInner() && safeDowncast<SHAMapInnerNode const&>(*root_).isEmpty())
+        return {};
+
+    NodePathStack stack;
+    walkTowardsKey(key, &stack);
+
+    std::vector<Blob> branch;
+    branch.reserve(stack.size());
+    while (!stack.empty())
+    {
+        Serializer s;
+        stack.top().first->serializeWithPrefix(s);
+        branch.emplace_back(std::move(s.modData()));
+        stack.pop();
+    }
+
+    JLOG(journal_.debug()) << "getProofBranch for key " << key << ", length " << branch.size();
+    return branch;
+}
+
 }  // namespace xrpl
