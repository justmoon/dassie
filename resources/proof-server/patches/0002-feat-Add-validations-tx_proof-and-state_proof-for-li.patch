@@ -0,0 +1,61 @@
+#pragma once
+
+#include <xrpld/rpc/Context.h>
+
+#include <xrpl/basics/Blob.h>
+#include <xrpl/json/json_value.h>
+#include <xrpl/ledger/Ledger.h>
+
+#include <rpcspec/Errors.hpp>
+
+#include <memory>
+#include <vector>
+
+namespace xrpl::rpc {
+
+/**
+ * @brief Looks up the closed ledger a proof request names.
+ *
+ * The request names a ledger by `ledger_hash` or `ledger_index`, as for any
+ * other method. A request that names none means the latest validated ledger,
+ * not the current one: an open ledger has no hash to prove anything against,
+ * so it is refused.
+ *
+ * On success, the result gets the ledger's fields (see injectProofLedger).
+ *
+ * @param ledger Reference to the ledger pointer to be filled.
+ * @param context The RPC context.
+ * @param result Reference to a json::Value to be filled with ledger data.
+ * @return Status indicating success or failure of the operation.
+ */
+::rpc::Status
+lookupProofLedger(
+    std::shared_ptr<Ledger const>& ledger,
+    JsonContext const& context,
+    json::Value& result);
+
+/**
+ * @brief Writes the fields that identify a closed ledger into a proof.
+ *
+ * Besides `ledger_hash`, `ledger_index` and `validated`, the result gets
+ * `ledger_header`: the ledger's header serialized as it is hashed, without the
+ * hash prefix, so that a client can compute the ledger's hash itself and check
+ * the roots the proof leads to.
+ *
+ * @param ledger The ledger to describe.
+ * @param context The RPC context.
+ * @param result Reference to a json::Value to be filled with ledger data.
+ */
+void
+injectProofLedger(Ledger const& ledger, Context const& context, json::Value& result);
+
+/**
+ * @brief Converts a branch from SHAMap::getProofBranch to JSON.
+ *
+ * @param branch The branch, deepest node first.
+ * @return An array of the nodes as hex strings, in the same order.
+ */
+json::Value
+branchToJson(std::vector<Blob> const& branch);
+
+}  // namespace xrpl::rpc
