+class TxProof_test : public beast::unit_test::Suite
+{
+    static json::Value
+    txProof(jtx::Env& env, unsigned apiVersion, json::Value const& params)
+    {
+        return env.rpc(apiVersion, "json", "tx_proof", to_string(params))[jss::result];
+    }
+
+    /**
+     * Check a tx_proof answer for a transaction as a client would: build the
+     * leaf from the transaction and metadata that `tx` gives in binary, and
+     * check it against the branch. Return the number of inner nodes in the
+     * branch, or zero if it does not prove the transaction.
+     */
+    std::size_t
+    checkProof(jtx::Env& env, unsigned apiVersion, json::Value const& result, uint256 const& txHash)
+    {
+        if (!BEAST_EXPECT(result[jss::status] == "success"))
+            return 0;
+        auto const header = readHeader(result);
+        BEAST_EXPECT(header.has_value());
+        if (!header)
+            return 0;
+        BEAST_EXPECT(to_string(header->hash) == result[jss::ledger_hash].asString());
+        BEAST_EXPECT(header->seq == result[jss::ledger_index].asUInt());
+
+        // API v1 names the blobs `tx` and `meta`, later versions `tx_blob` and
+        // `meta_blob`.
+        json::Value txParams;
+        txParams[jss::transaction] = to_string(txHash);
+        txParams[jss::binary] = true;
+        auto const found = env.rpc(apiVersion, "json", "tx", to_string(txParams))[jss::result];
+        auto const tx = strUnHex(
+            (found.isMember(jss::tx_blob) ? found[jss::tx_blob] : found[jss::tx]).asString());
+        auto const meta = strUnHex(
+            (found.isMember(jss::meta_blob) ? found[jss::meta_blob] : found[jss::meta]).asString());
+        BEAST_EXPECT(tx && meta);
+        if (!tx || !meta)
+            return 0;
+        BEAST_EXPECT(sha512Half(HashPrefix::TransactionId, makeSlice(*tx)) == txHash);
+
+        // The leaf is the prefix, the transaction and its metadata, each with
+        // its length, and the transaction's hash; the branch starts above it.
+        Serializer leaf;
+        leaf.add32(HashPrefix::TxNode);
+        leaf.addVL(makeSlice(*tx));
+        leaf.addVL(makeSlice(*meta));
+        leaf.addBitString(txHash);
+        json::Value withLeaf{json::ValueType::Array};
+        withLeaf.append(strHex(leaf.slice()));
+        for (auto const& node : result[jss::path])
+            withLeaf.append(node);
+        if (!BEAST_EXPECT(checkPath(header->txRoot, txHash, withLeaf) == Proven::Present))
+            return 0;
+        return result[jss::path].size();
+    }
+
+    void
+    testPresent(unsigned apiVersion)
+    {
+        testcase("Transactions present, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        Account const alice{"alice"};
+        Account const bob{"bob"};
+        env.fund(XRP(10000), alice, bob);
+        env.close();
+
+        // A ledger with a single transaction: its leaf hangs off the root, which
+        // is all the branch holds.
+        env(pay(alice, bob, XRP(1)));
+        auto const single = env.tx()->getTransactionID();
+        env.close();
+        json::Value params;
+        params[jss::tx_hash] = to_string(single);
+        BEAST_EXPECT(checkProof(env, apiVersion, txProof(env, apiVersion, params), single) == 1);
+
+        // A ledger with several.
+        std::vector<uint256> hashes;
+        for (int i = 0; i < 20; ++i)
+        {
+            env(pay(alice, bob, XRP(1)));
+            hashes.push_back(env.tx()->getTransactionID());
+        }
+        env.close();
+        auto const seq = env.closed()->seq();
+        for (auto const& hash : hashes)
+        {
+            // Found by the server, or in the ledger named.
+            params[jss::tx_hash] = to_string(hash);
+            auto const found = txProof(env, apiVersion, params);
+            BEAST_EXPECT(checkProof(env, apiVersion, found, hash) >= 1);
+            BEAST_EXPECT(found[jss::ledger_index] == seq);
+            BEAST_EXPECT(found[jss::validated] == true);
+
+            auto named = params;
+            named[jss::ledger_index] = seq;
+            BEAST_EXPECT(checkProof(env, apiVersion, txProof(env, apiVersion, named), hash) >= 1);
+        }
+    }
+
+    void
+    testErrors(unsigned apiVersion)
+    {
+        testcase("Errors, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        Account const alice{"alice"};
+        Account const bob{"bob"};
+        env.fund(XRP(10000), alice, bob);
+        env.close();
+        env(pay(alice, bob, XRP(1)));
+        auto const hash = env.tx()->getTransactionID();
+        env.close();
+        // A ledger with no transactions.
+        env.close();
+        auto const empty = env.closed()->seq();
+
+        {
+            expectError(
+                *this,
+                txProof(env, apiVersion, json::Value{json::ValueType::Object}),
+                "invalidParams",
+                RpcInvalidParams,
+                "Missing field 'tx_hash'.");
+        }
+        for (auto const& bad :
+             {json::Value{to_string(hash).substr(1)}, json::Value{7}, json::Value{"zz"}})
+        {
+            json::Value params;
+            params[jss::tx_hash] = bad;
+            expectError(
+                *this,
+                txProof(env, apiVersion, params),
+                "invalidParams",
+                RpcInvalidParams,
+                "Invalid field 'tx_hash', not hex string.");
+        }
+        {
+            json::Value params;
+            params[jss::tx_hash] = to_string(sha512Half(std::uint32_t{1}));
+            expectError(
+                *this,
+                txProof(env, apiVersion, params),
+                "txnNotFound",
+                RpcTxnNotFound,
+                "Transaction not found.");
+        }
+        {
+            // In another ledger than the one named, or in an empty one.
+            for (auto const seq : {empty, empty - 2})
+            {
+                json::Value params;
+                params[jss::tx_hash] = to_string(hash);
+                params[jss::ledger_index] = seq;
+                auto const result = txProof(env, apiVersion, params);
+                BEAST_EXPECT(result[jss::error] == "txnNotFound");
+                BEAST_EXPECT(result[jss::error_code] == RpcTxnNotFound);
+            }
+        }
+        {
+            json::Value params;
+            params[jss::tx_hash] = to_string(hash);
+            params[jss::ledger_index] = "current";
+            expectError(
+                *this,
+                txProof(env, apiVersion, params),
+                "invalidParams",
+                RpcInvalidParams,
+                "A proof needs a closed ledger.");
+        }
+        {
+            json::Value params;
+            params[jss::tx_hash] = to_string(hash);
+            params[jss::ledger_index] = 1000000;
+            auto const result = txProof(env, apiVersion, params);
+            BEAST_EXPECT(result[jss::error] == "lgrNotFound");
+            BEAST_EXPECT(result[jss::error_code] == RpcLgrNotFound);
+        }
+    }
+
+public:
+    void
+    run() override
+    {
+        forAllApiVersions([this](unsigned apiVersion) {
+            testPresent(apiVersion);
+            testErrors(apiVersion);
+        });
+    }
+};
+
+class ValidationsRPC_test : public beast::unit_test::Suite
+{
+    static json::Value
+    validations(jtx::Env& env, unsigned apiVersion, json::Value const& params)
+    {
+        return env.rpc(apiVersion, "json", "validations", to_string(params))[jss::result];
+    }
+
+    void
+    testValidations(unsigned apiVersion)
+    {
+        testcase("Validations, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        env.close();
+        auto const ledger = env.closed();
+
+        auto const make = [&](bool trusted, bool full) {
+            auto const keys = randomKeyPair(KeyType::Secp256k1);
+            auto val = std::make_shared<STValidation>(
+                env.app().getTimeKeeper().now(),
+                keys.first,
+                keys.second,
+                calcNodeID(keys.first),
+                [&](STValidation& v) {
+                    v.setFieldH256(sfLedgerHash, ledger->header().hash);
+                    v.setFieldU32(sfLedgerSequence, ledger->seq());
+                    if (full)
+                        v.setFlag(kVfFullValidation);
+                });
+            if (!trusted)
+                val->setUntrusted();
+            return val;
+        };
+
+        // Full or partial, the server returns those of the validators it
+        // trusts, and with `untrusted` the others too.
+        std::set<std::string> trusted;
+        std::set<std::string> all;
+        for (auto const& val : {make(true, true), make(false, true), make(true, false)})
+        {
+            BEAST_EXPECT(
+                env.app().getValidations().add(
+                    calcNodeID(val->getSignerPublic()), RCLValidation{val}) == ValStatus::Current);
+            auto const hex = strHex(val->getSerializer().slice());
+            all.insert(hex);
+            if (val->isTrusted())
+                trusted.insert(hex);
+        }
+
+        auto const check = [&](json::Value const& result, std::set<std::string> const& expected) {
+            BEAST_EXPECT(result[jss::status] == "success");
+            BEAST_EXPECT(result[jss::ledger_hash] == to_string(ledger->header().hash));
+            BEAST_EXPECT(!result.isMember(jss::truncated));
+            auto const& array = result[jss::validations];
+            if (!BEAST_EXPECT(array.isArray() && array.size() == expected.size()))
+                return;
+            std::set<std::string> got;
+            for (auto const& hex : array)
+            {
+                got.insert(hex.asString());
+
+                // Each parses as a validation of the ledger, and its
+                // signature checks.
+                auto const blob = strUnHex(hex.asString());
+                BEAST_EXPECT(blob.has_value());
+                if (!blob)
+                    continue;
+                SerialIter sit{makeSlice(*blob)};
+                STValidation const val{
+                    sit,
+                    [](PublicKey const& pk) { return calcNodeID(pk); },
+                    STValidation::DeserializeOptions{
+                        .checkSignature = true,
+                        .requireCanonicalOrder = true,
+                    }};
+                BEAST_EXPECT(val.getLedgerHash() == ledger->header().hash);
+            }
+            BEAST_EXPECT(got == expected);
+        };
+
+        json::Value params;
+        params[jss::ledger_hash] = to_string(ledger->header().hash);
+        check(validations(env, apiVersion, params), trusted);
+        params[jss::untrusted] = false;
+        check(validations(env, apiVersion, params), trusted);
+        params[jss::untrusted] = true;
+        check(validations(env, apiVersion, params), all);
+        for (auto const& bad : {json::Value{"yes"}, json::Value{1}})
+        {
+            params[jss::untrusted] = bad;
+            expectError(
+                *this,
+                validations(env, apiVersion, params),
+                "invalidParams",
+                RpcInvalidParams,
+                "Invalid field 'untrusted', not boolean.");
+        }
+        params.removeMember(jss::untrusted);
+
+        // No validations held for a ledger
+        params[jss::ledger_hash] = to_string(sha512Half(std::uint32_t{1}));
+        auto const none = validations(env, apiVersion, params);
+        BEAST_EXPECT(none[jss::status] == "success");
+        BEAST_EXPECT(none[jss::validations].isArray() && none[jss::validations].size() == 0);
+
+        expectError(
+            *this,
+            validations(env, apiVersion, json::Value{json::ValueType::Object}),
+            "invalidParams",
+            RpcInvalidParams,
+            "Missing field 'ledger_hash'.");
+        for (auto const& bad : {json::Value{"zz"}, json::Value{7}})
+        {
+            params[jss::ledger_hash] = bad;
+            expectError(
+                *this,
+                validations(env, apiVersion, params),
+                "invalidParams",
+                RpcInvalidParams,
+                "Invalid field 'ledger_hash', not hex string.");
+        }
+    }
+
+    void
+    testBounded()
+    {
+        testcase("Validations with untrusted, bounded, trusted first");
+        using namespace jtx;
+        Env env{*this};
+        env.close();
+        auto const ledger = env.closed();
+
+        auto const add = [&](bool trusted) {
+            auto const keys = randomKeyPair(KeyType::Secp256k1);
+            auto const val = std::make_shared<STValidation>(
+                env.app().getTimeKeeper().now(),
+                keys.first,
+                keys.second,
+                calcNodeID(keys.first),
+                [&](STValidation& v) {
+                    v.setFieldH256(sfLedgerHash, ledger->header().hash);
+                    v.setFieldU32(sfLedgerSequence, ledger->seq());
+                    v.setFlag(kVfFullValidation);
+                });
+            if (!trusted)
+                val->setUntrusted();
+            BEAST_EXPECT(
+                env.app().getValidations().add(
+                    calcNodeID(val->getSignerPublic()), RCLValidation{val}) == ValStatus::Current);
+            return strHex(val->getSerializer().slice());
+        };
+
+        // More validations from keys nobody trusts than an answer holds, and
+        // two trusted ones after them.
+        for (int i = 0; i < 300; ++i)
+            add(false);
+        std::set<std::string> const trusted{add(true), add(true)};
+
+        json::Value params;
+        params[jss::ledger_hash] = to_string(ledger->header().hash);
+
+        // By default, only the trusted ones, however many others there are.
+        auto const own = validations(env, 2, params);
+        BEAST_EXPECT(!own.isMember(jss::truncated));
+        BEAST_EXPECT(own[jss::validations].size() == trusted.size());
+
+        params[jss::untrusted] = true;
+        auto const result = validations(env, 2, params);
+        BEAST_EXPECT(result[jss::truncated] == true);
+        auto const& array = result[jss::validations];
+        BEAST_EXPECT(array.isArray() && array.size() == 256);
+        std::size_t found = 0;
+        for (auto const& hex : array)
+            found += trusted.contains(hex.asString()) ? 1 : 0;
+        BEAST_EXPECT(found == trusted.size());
+    }
+
+public:
+    void
+    run() override
+    {
+        forAllApiVersions([this](unsigned apiVersion) { testValidations(apiVersion); });
+        testBounded();
+    }
+};
+
+BEAST_DEFINE_TESTSUITE(StateProof, rpc, xrpl);
+BEAST_DEFINE_TESTSUITE(TxProof, rpc, xrpl);
+BEAST_DEFINE_TESTSUITE(ValidationsRPC, rpc, xrpl);
+
+}  // namespace xrpl::test
