+/**
+ * The fields of a ledger header that a proof is checked against, read from
+ * the `ledger_header` of an answer as a client would read them.
+ */
+struct ProvenHeader
+{
+    std::uint32_t seq = 0;
+    uint256 hash;
+    uint256 txRoot;
+    uint256 stateRoot;
+};
+
+[[nodiscard]] std::optional<ProvenHeader>
+readHeader(json::Value const& result)
+{
+    if (!result[jss::ledger_header].isString())
+        return std::nullopt;
+    auto const bytes = strUnHex(result[jss::ledger_header].asString());
+    if (!bytes || bytes->size() != 118)
+        return std::nullopt;
+
+    Serializer s;
+    s.add32(HashPrefix::LedgerMaster);
+    s.addRaw(makeSlice(*bytes));
+
+    ProvenHeader header;
+    header.hash = sha512Half(s.slice());
+    SerialIter sit{makeSlice(*bytes)};
+    header.seq = sit.get32();
+    (void)sit.get64();              // drops
+    (void)sit.getBitString<256>();  // parent hash
+    header.txRoot = sit.getBitString<256>();
+    header.stateRoot = sit.getBitString<256>();
+    return header;
+}
+
+/**
+ * What a branch proves about a key.
+ */
+enum class Proven : std::uint8_t { Present, AbsentAtEmptySlot, AbsentAtOtherLeaf, Invalid };
+
+/**
+ * Check a `path` against a root hash, from its bytes alone: each node must
+ * hash to the hash its parent names for the key, and the branch must end at
+ * the key's leaf, at another key's leaf, or at an empty slot.
+ */
+[[nodiscard]] Proven
+checkPath(uint256 const& root, uint256 const& key, json::Value const& path, Blob* leaf = nullptr)
+{
+    if (!path.isArray())
+        return Proven::Invalid;
+    if (path.size() == 0)
+        return root.isZero() ? Proven::AbsentAtEmptySlot : Proven::Invalid;
+
+    uint256 expected = root;
+    for (unsigned depth = 0; depth < path.size(); ++depth)
+    {
+        bool const last = depth + 1 == path.size();
+        auto const& hex = path[path.size() - 1 - depth];
+        auto const blob = hex.isString() ? strUnHex(hex.asString()) : std::nullopt;
+        if (!blob || blob->size() < 4 + 32 || sha512Half(makeSlice(*blob)) != expected)
+            return Proven::Invalid;
+
+        auto const prefix = SerialIter{makeSlice(*blob)}.get32();
+        if (prefix == static_cast<std::uint32_t>(HashPrefix::InnerNode))
+        {
+            if (blob->size() != 4 + (16 * 32) || depth >= 64)
+                return Proven::Invalid;
+            // The key's nibble at this depth.
+            auto const byte = key.data()[depth / 2];
+            auto const nibble = (depth % 2 == 0) ? (byte >> 4) : (byte & 0xf);
+            expected = uint256::fromVoid(blob->data() + 4 + (nibble * 32));
+            if (expected.isZero())
+                return last ? Proven::AbsentAtEmptySlot : Proven::Invalid;
+            if (last)
+                return Proven::Invalid;
+        }
+        else if (
+            prefix == static_cast<std::uint32_t>(HashPrefix::LeafNode) ||
+            prefix == static_cast<std::uint32_t>(HashPrefix::TxNode))
+        {
+            if (!last)
+                return Proven::Invalid;
+            if (leaf != nullptr)
+                *leaf = *blob;
+            return uint256::fromVoid(blob->data() + blob->size() - 32) == key
+                ? Proven::Present
+                : Proven::AbsentAtOtherLeaf;
+        }
+        else
+        {
+            return Proven::Invalid;
+        }
+    }
+    return Proven::Invalid;
+}
+
+void
+expectError(
+    beast::unit_test::Suite& suite,
+    json::Value const& result,
+    std::string const& error,
+    ErrorCodeI code,
+    std::string const& message)
+{
+    suite.expect(result[jss::status] == "error", "status");
+    suite.expect(result[jss::error] == error, "error: " + result[jss::error].asString());
+    suite.expect(result[jss::error_code] == code, "error_code");
+    suite.expect(
+        result[jss::error_message] == message,
+        "error_message: " + result[jss::error_message].asString());
+}
