diff --git a/src/xrpld/rpc/handlers/ledger/StateProof.cpp b/src/xrpld/rpc/handlers/ledger/StateProof.cpp
new file mode 100644
index 0000000000..ccd32c409d
--- /dev/null
+++ b/src/xrpld/rpc/handlers/ledger/StateProof.cpp
@@ -0,0 +1,97 @@
+#include <xrpld/rpc/Context.h>
+#include <xrpld/rpc/detail/ProofHelpers.h>
+#include <xrpld/rpc/detail/SpecBridge.hpp>
+#include <xrpld/rpc/detail/Tuning.h>
+
+#include <xrpl/basics/base_uint.h>
+#include <xrpl/json/json_value.h>
+#include <xrpl/ledger/Ledger.h>
+#include <xrpl/protocol/ErrorCodes.h>
+#include <xrpl/protocol/RPCErr.h>
+#include <xrpl/protocol/jss.h>
+#include <xrpl/resource/Fees.h>
+#include <xrpl/shamap/SHAMapMissingNode.h>
+
+#include <algorithm>
+#include <expected>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace xrpl {
+
+static std::expected<std::vector<UInt256>, json::Value>
+parseKeys(json::Value const& params)
+{
+    if (!params.isMember(jss::keys))
+        return std::unexpected(rpc::missingFieldError(jss::keys));
+
+    auto const& keys = params[jss::keys];
+    if (!keys.isArray() || keys.size() == 0)
+        return std::unexpected(rpc::expectedFieldError(jss::keys, "non-empty array"));
+    if (keys.size() > rpc::tuning::kMaxProofKeys)
+        return std::unexpected(rpc::expectedFieldError(jss::keys, "array too long"));
+
+    std::vector<UInt256> parsed;
+    parsed.reserve(keys.size());
+    for (auto const& key : keys)
+    {
+        UInt256 k;
+        // asString() throws on an object or an array, so the type comes first.
+        if (!key.isString() || !k.parseHex(key.asString()))
+            return std::unexpected(rpc::expectedFieldError(jss::keys, "array of hex strings"));
+        if (std::ranges::find(parsed, k) != parsed.end())
+            return std::unexpected(rpc::expectedFieldError(jss::keys, "array of distinct keys"));
+        parsed.push_back(k);
+    }
+    return parsed;
+}
+
+// {
+//   keys: [<hex>, ...]
+//   ledger_hash : <ledger>
+//   ledger_index : <ledger_index>
+// }
+//
+// For each key, the branch of the ledger's state tree that proves the ledger
+// entry under it, or proves that there is none. The entry is the leaf the
+// branch starts at.
+json::Value
+doStateProof(rpc::JsonContext& context)
+{
+    context.loadType = resource::kFeeMediumBurdenRpc;
+
+    auto const keys = parseKeys(context.params);
+    if (!keys)
+        return keys.error();
+
+    json::Value jvResult;
+    std::shared_ptr<Ledger const> ledger;
+    if (auto const status = rpc::lookupProofLedger(ledger, context, jvResult))
+    {
+        rpc::injectSpecError(jvResult, status);
+        return jvResult;
+    }
+
+    try
+    {
+        json::Value entries{json::ValueType::Array};
+        for (auto const& key : *keys)
+        {
+            json::Value entry{json::ValueType::Object};
+            entry[jss::key] = to_string(key);
+            entry[jss::path] = rpc::branchToJson(ledger->stateMap().getProofBranch(key));
+            entries.append(std::move(entry));
+        }
+        jvResult[jss::entries] = std::move(entries);
+    }
+    catch (SHAMapMissingNode const&)
+    {
+        // The server has the ledger's header, but not all of its state.
+        return rpcError(RpcLgrNotFound);
+    }
+
+    return jvResult;
+}
+
+}  // namespace xrpl
diff --git a/src/xrpld/rpc/handlers/ledger/Validations.cpp b/src/xrpld/rpc/handlers/ledger/Validations.cpp
new file mode 100644
index 0000000000..92472c5494
--- /dev/null
+++ b/src/xrpld/rpc/handlers/ledger/Validations.cpp
@@ -0,0 +1,79 @@
+#include <xrpld/app/consensus/RCLValidations.h>
+#include <xrpld/app/main/Application.h>
+#include <xrpld/rpc/Context.h>
+#include <xrpld/rpc/detail/Tuning.h>
+
+#include <xrpl/basics/base_uint.h>
+#include <xrpl/basics/strHex.h>
+#include <xrpl/json/json_value.h>
+#include <xrpl/protocol/ErrorCodes.h>
+#include <xrpl/protocol/RippleLedgerHash.h>
+#include <xrpl/protocol/jss.h>
+#include <xrpl/resource/Fees.h>
+
+#include <algorithm>
+
+namespace xrpl {
+
+// {
+//   ledger_hash : <ledger>
+//   untrusted : <bool>                     optional, false by default
+// }
+//
+// The validations the server holds for the ledger from the validators it
+// trusts, full or partial, each serialized as it was signed. The client
+// decides which validators it trusts itself. With `untrusted`, the answer
+// also holds validations from keys the server does not trust, for a client
+// whose validators differ from the server's. That answer is bounded: the
+// server's trusted validations come first, so that validations from keys
+// nobody trusts can only crowd out others like them, and a cut answer says
+// so.
+json::Value
+doValidations(rpc::JsonContext& context)
+{
+    context.loadType = resource::kFeeMediumBurdenRpc;
+
+    auto const& params = context.params;
+    if (!params.isMember(jss::ledger_hash))
+        return rpc::missingFieldError(jss::ledger_hash);
+
+    // asString() throws on an object or an array, so the type comes first.
+    LedgerHash ledgerHash;
+    if (!params[jss::ledger_hash].isString() ||
+        !ledgerHash.parseHex(params[jss::ledger_hash].asString()))
+    {
+        return rpc::expectedFieldError(jss::ledger_hash, "hex string");
+    }
+
+    bool untrusted = false;
+    if (params.isMember(jss::untrusted))
+    {
+        if (!params[jss::untrusted].isBool())
+            return rpc::expectedFieldError(jss::untrusted, "boolean");
+        untrusted = params[jss::untrusted].asBool();
+    }
+
+    json::Value jvResult;
+    jvResult[jss::ledger_hash] = to_string(ledgerHash);
+    json::Value& validations = (jvResult[jss::validations] = json::Value{json::ValueType::Array});
+    auto held = context.app.getValidations().getAllForLedger(ledgerHash);
+    auto const others =
+        std::ranges::stable_partition(held, [](auto const& v) { return v->isTrusted(); });
+    if (!untrusted)
+    {
+        held.erase(others.begin(), others.end());
+    }
+    else if (held.size() > rpc::tuning::kMaxValidations)
+    {
+        // So that a client whose validators the server does not trust can
+        // tell a cut answer from too few of them signing.
+        held.resize(rpc::tuning::kMaxValidations);
+        jvResult[jss::truncated] = true;
+    }
+    for (auto const& validation : held)
+        validations.append(strHex(validation->getSerializer().slice()));
+
+    return jvResult;
+}
+
+}  // namespace xrpl
diff --git a/src/xrpld/rpc/handlers/transaction/TxProof.cpp b/src/xrpld/rpc/handlers/transaction/TxProof.cpp
new file mode 100644
index 0000000000..59f965d51e
--- /dev/null
+++ b/src/xrpld/rpc/handlers/transaction/TxProof.cpp
@@ -0,0 +1,107 @@
+#include <xrpld/app/ledger/LedgerMaster.h>
+#include <xrpld/app/ledger/TransactionMaster.h>
+#include <xrpld/app/main/Application.h>
+#include <xrpld/app/misc/Transaction.h>
+#include <xrpld/rpc/Context.h>
+#include <xrpld/rpc/detail/ProofHelpers.h>
+#include <xrpld/rpc/detail/SpecBridge.hpp>
+
+#include <xrpl/basics/base_uint.h>
+#include <xrpl/beast/utility/instrumentation.h>
+#include <xrpl/json/json_value.h>
+#include <xrpl/ledger/Ledger.h>
+#include <xrpl/protocol/ErrorCodes.h>
+#include <xrpl/protocol/RPCErr.h>
+#include <xrpl/protocol/TxMeta.h>
+#include <xrpl/protocol/jss.h>
+#include <xrpl/resource/Fees.h>
+#include <xrpl/shamap/SHAMapMissingNode.h>
+
+#include <memory>
+#include <utility>
+#include <variant>
+
+namespace xrpl {
+
+// {
+//   tx_hash : <transaction hash>
+//   ledger_hash : <ledger>                 optional
+//   ledger_index : <ledger_index>          optional
+// }
+//
+// The branch of the ledger's transaction tree that proves a transaction and
+// its metadata, from the inner node above its leaf up to the root. Without a
+// ledger, the server looks up which ledger holds the transaction.
+json::Value
+doTxProof(rpc::JsonContext& context)
+{
+    context.loadType = resource::kFeeMediumBurdenRpc;
+
+    auto const& params = context.params;
+    if (!params.isMember(jss::tx_hash))
+        return rpc::missingFieldError(jss::tx_hash);
+
+    // asString() throws on an object or an array, so the type comes first.
+    UInt256 txHash;
+    if (!params[jss::tx_hash].isString() || !txHash.parseHex(params[jss::tx_hash].asString()))
+        return rpc::expectedFieldError(jss::tx_hash, "hex string");
+
+    json::Value jvResult;
+    std::shared_ptr<Ledger const> ledger;
+    if (params.isMember(jss::ledger) || params.isMember(jss::ledger_hash) ||
+        params.isMember(jss::ledger_index))
+    {
+        if (auto const status = rpc::lookupProofLedger(ledger, context, jvResult))
+        {
+            rpc::injectSpecError(jvResult, status);
+            return jvResult;
+        }
+    }
+    else
+    {
+        if (!context.app.config().useTxTables())
+            return rpcError(RpcNotEnabled);
+
+        using TxPair = std::pair<std::shared_ptr<Transaction>, std::shared_ptr<TxMeta>>;
+        auto ec{RpcSuccess};
+        auto const found = context.app.getMasterTransaction().fetch(txHash, ec);
+        if (ec == RpcDbDeserialization)
+            return rpcError(ec);
+
+        auto const* const pair = std::get_if<TxPair>(&found);
+        if ((pair == nullptr) || !pair->first || pair->first->getLedger() == 0)
+            return rpcError(RpcTxnNotFound);
+
+        ledger = context.ledgerMaster.getLedgerBySeq(pair->first->getLedger());
+        if (!ledger)
+            return rpcError(RpcLgrNotFound);
+
+        rpc::injectProofLedger(*ledger, context, jvResult);
+    }
+
+    try
+    {
+        if (!ledger->txMap().hasItem(txHash))
+        {
+            rpc::injectError(RpcTxnNotFound, jvResult);
+            return jvResult;
+        }
+
+        // The client has the transaction and its metadata already, from `tx`
+        // or `account_tx` in binary, and builds the leaf from them: the
+        // branch starts at the inner node above it.
+        auto branch = ledger->txMap().getProofBranch(txHash);
+        XRPL_ASSERT(branch.size() >= 2, "xrpl::doTxProof : branch holds a leaf and the root");
+        branch.erase(branch.begin());
+        jvResult[jss::path] = rpc::branchToJson(branch);
+    }
+    catch (SHAMapMissingNode const&)
+    {
+        // The server has the ledger's header, but not all of its transactions.
+        return rpcError(RpcLgrNotFound);
+    }
+
+    return jvResult;
+}
+
+}  // namespace xrpl
