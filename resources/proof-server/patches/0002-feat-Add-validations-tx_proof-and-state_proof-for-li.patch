+
+/**
+ * Maximum number of validations in one validations answer: more than any
+ * UNL, so the server's trusted validations always fit.
+ */
+static constexpr std::size_t kMaxValidations = 256;
+
 /**
  * Maximum number of pages in a LedgerData response.
