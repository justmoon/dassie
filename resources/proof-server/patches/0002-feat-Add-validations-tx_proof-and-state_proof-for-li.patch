+#include <xrpld/rpc/detail/ProofHelpers.h>
+
+#include <xrpld/rpc/Context.h>
+#include <xrpld/rpc/detail/RPCLedgerHelpers.h>
+
+#include <xrpl/basics/Blob.h>
+#include <xrpl/basics/strHex.h>
+#include <xrpl/json/json_value.h>
+#include <xrpl/ledger/Ledger.h>
+#include <xrpl/ledger/ReadView.h>
+#include <xrpl/protocol/ErrorCodes.h>
+#include <xrpl/protocol/LedgerHeader.h>
+#include <xrpl/protocol/Serializer.h>
+#include <xrpl/protocol/jss.h>
+
+#include <rpcspec/Errors.hpp>
+#include <rpcspec/Ledger.hpp>
+
+#include <memory>
+#include <vector>
+
+namespace xrpl::rpc {
+
+::rpc::Status
+lookupProofLedger(
+    std::shared_ptr<Ledger const>& ledger,
+    JsonContext const& context,
+    json::Value& result)
+{
+    ledger.reset();
+
+    std::shared_ptr<ReadView const> view;
+    auto const& params = context.params;
+    if (params.isMember(jss::ledger) || params.isMember(jss::ledger_hash) ||
+        params.isMember(jss::ledger_index))
+    {
+        json::Value fields;
+        if (auto status = lookupLedger(view, context, fields))
+            return status;
+    }
+    else if (auto status = getLedger(view, ::rpc::spec::LedgerShortcut::Validated, context))
+    {
+        return status;
+    }
+
+    // Only a closed ledger is a Ledger: the open one is an OpenView.
+    ledger = std::dynamic_pointer_cast<Ledger const>(view);
+    if (!ledger || view->open())
+    {
+        ledger.reset();
+        return {RpcInvalidParams, "A proof needs a closed ledger."};
+    }
+
+    injectProofLedger(*ledger, context, result);
+    return ::rpc::Status::kOK;
+}
+
+void
+injectProofLedger(Ledger const& ledger, Context const& context, json::Value& result)
+{
+    injectLedgerFields(ledger, context, result);
+
+    Serializer s;
+    addRaw(ledger.header(), s);
+    result[jss::ledger_header] = strHex(s.peekData());
+}
+
+json::Value
+branchToJson(std::vector<Blob> const& branch)
+{
+    json::Value nodes{json::ValueType::Array};
+    for (auto const& node : branch)
+        nodes.append(strHex(node));
+    return nodes;
+}
+
+}  // namespace xrpl::rpc
