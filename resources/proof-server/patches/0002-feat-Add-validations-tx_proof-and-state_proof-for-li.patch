+
+class StateProof_test : public beast::unit_test::Suite
+{
+    static json::Value
+    stateProof(jtx::Env& env, unsigned apiVersion, json::Value const& params)
+    {
+        return env.rpc(apiVersion, "json", "state_proof", to_string(params))[jss::result];
+    }
+
+    static json::Value
+    keysOf(std::vector<uint256> const& keys)
+    {
+        json::Value array{json::ValueType::Array};
+        for (auto const& key : keys)
+            array.append(to_string(key));
+        return array;
+    }
+
+    void
+    testPresent(unsigned apiVersion)
+    {
+        testcase("Entries present, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        Account const alice{"alice"};
+        env.fund(XRP(10000), alice);
+        env.close();
+
+        std::vector<uint256> const keys{
+            keylet::account(alice).key,
+            keylet::feeSettings().key,
+            keylet::skip().key,
+        };
+        json::Value params;
+        params[jss::keys] = keysOf(keys);
+        // No ledger named: the latest validated ledger.
+        auto const result = stateProof(env, apiVersion, params);
+        BEAST_EXPECT(result[jss::status] == "success");
+        BEAST_EXPECT(result[jss::validated] == true);
+
+        auto const header = readHeader(result);
+        BEAST_EXPECT(header.has_value());
+        if (!header)
+            return;
+        BEAST_EXPECT(to_string(header->hash) == result[jss::ledger_hash].asString());
+        BEAST_EXPECT(header->seq == result[jss::ledger_index].asUInt());
+        BEAST_EXPECT(
+            header->hash == env.app().getLedgerMaster().getValidatedLedger()->header().hash);
+
+        auto const& entries = result[jss::entries];
+        if (!BEAST_EXPECT(entries.isArray() && entries.size() == keys.size()))
+            return;
+        for (unsigned i = 0; i < keys.size(); ++i)
+        {
+            auto const& entry = entries[i];
+            BEAST_EXPECT(entry[jss::key] == to_string(keys[i]));
+            Blob leaf;
+            BEAST_EXPECT(
+                checkPath(header->stateRoot, keys[i], entry[jss::path], &leaf) == Proven::Present);
+
+            // The leaf is the prefix, the entry as ledger_entry gives it in
+            // binary, and its key.
+            json::Value entryParams;
+            entryParams[jss::index] = to_string(keys[i]);
+            entryParams[jss::binary] = true;
+            entryParams[jss::ledger_hash] = result[jss::ledger_hash];
+            auto const ledgerEntry =
+                env.rpc(apiVersion, "json", "ledger_entry", to_string(entryParams))[jss::result];
+            Serializer expected;
+            expected.add32(HashPrefix::LeafNode);
+            expected.addRaw(
+                makeSlice(strUnHex(ledgerEntry[jss::node_binary].asString()).value_or(Blob{})));
+            expected.addBitString(keys[i]);
+            BEAST_EXPECT(leaf == expected.peekData());
+        }
+    }
+
+    void
+    testAbsent(unsigned apiVersion)
+    {
+        testcase("Entries absent, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        Account const alice{"alice"};
+        Account const bob{"bob"};
+        env.fund(XRP(10000), alice);
+        env.close();
+
+        // An account that does not exist; a key that differs from alice's
+        // only in its last nibble, which meets alice's leaf; and a key under
+        // each first nibble, of which some meet an empty slot in the root of
+        // this small tree. Before ledger 256, there is no skip list of flag
+        // ledgers either.
+        auto const aliceKey = keylet::account(alice).key;
+        auto nextToAlice = aliceKey;
+        nextToAlice.data()[31] ^= 0x01;
+        std::vector<uint256> keys{
+            keylet::account(bob).key,
+            nextToAlice,
+            keylet::skip(env.closed()->seq()).key,
+        };
+        for (std::uint8_t nibble = 0; nibble < 16; ++nibble)
+        {
+            uint256 key;
+            key.data()[0] = static_cast<std::uint8_t>(nibble << 4);
+            keys.push_back(key);
+        }
+
+        json::Value params;
+        params[jss::keys] = keysOf(keys);
+        params[jss::ledger_index] = "validated";
+        auto const result = stateProof(env, apiVersion, params);
+        BEAST_EXPECT(result[jss::status] == "success");
+        auto const header = readHeader(result);
+        BEAST_EXPECT(header.has_value());
+        if (!header)
+            return;
+
+        auto const& entries = result[jss::entries];
+        if (!BEAST_EXPECT(entries.isArray() && entries.size() == keys.size()))
+            return;
+        std::size_t emptySlots = 0;
+        std::size_t depthOne = 0;
+        for (unsigned i = 0; i < keys.size(); ++i)
+        {
+            auto const& entry = entries[i];
+            auto const proven = checkPath(header->stateRoot, keys[i], entry[jss::path]);
+            if (i < 3)
+            {
+                BEAST_EXPECT(
+                    proven == Proven::AbsentAtEmptySlot || proven == Proven::AbsentAtOtherLeaf);
+            }
+            BEAST_EXPECT(proven != Proven::Invalid && proven != Proven::Present);
+            if (proven == Proven::AbsentAtEmptySlot && entry[jss::path].size() == 1)
+                ++emptySlots;
+            if (proven == Proven::AbsentAtOtherLeaf && entry[jss::path].size() == 2)
+                ++depthOne;
+        }
+        BEAST_EXPECT(
+            checkPath(header->stateRoot, nextToAlice, entries[1u][jss::path]) ==
+            Proven::AbsentAtOtherLeaf);
+        BEAST_EXPECT(emptySlots > 0);
+        BEAST_EXPECT(depthOne > 0);
+
+        // The branch that proves the neighbour absent proves alice present.
+        BEAST_EXPECT(
+            checkPath(header->stateRoot, aliceKey, entries[1u][jss::path]) == Proven::Present);
+    }
+
+    void
+    testLedgers(unsigned apiVersion)
+    {
+        testcase("Ledgers, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+        Account const alice{"alice"};
+        env.fund(XRP(10000), alice);
+        env.close();
+        // A ledger with no transactions: its transaction tree is empty.
+        env.close();
+        auto const empty = env.closed();
+        BEAST_EXPECT(empty->header().txHash.isZero());
+
+        json::Value params;
+        params[jss::keys] = keysOf({keylet::account(alice).key});
+
+        // By index, by hash, closed
+        for (auto const& [field, value] : std::vector<std::pair<json::StaticString, json::Value>>{
+                 {jss::ledger_index, empty->seq()},
+                 {jss::ledger_hash, to_string(empty->header().hash)},
+                 {jss::ledger_index, "closed"},
+             })
+        {
+            auto request = params;
+            request[field] = value;
+            auto const result = stateProof(env, apiVersion, request);
+            BEAST_EXPECT(result[jss::status] == "success");
+            auto const header = readHeader(result);
+            BEAST_EXPECT(header.has_value());
+            if (!header)
+                continue;
+            BEAST_EXPECT(header->hash == empty->header().hash);
+            BEAST_EXPECT(header->txRoot.isZero());
+            BEAST_EXPECT(
+                checkPath(
+                    header->stateRoot,
+                    keylet::account(alice).key,
+                    result[jss::entries][0u][jss::path]) == Proven::Present);
+        }
+
+        {
+            auto request = params;
+            request[jss::ledger_index] = "current";
+            expectError(
+                *this,
+                stateProof(env, apiVersion, request),
+                "invalidParams",
+                RpcInvalidParams,
+                "A proof needs a closed ledger.");
+        }
+        {
+            auto request = params;
+            request[jss::ledger_index] = 1000000;
+            auto const result = stateProof(env, apiVersion, request);
+            BEAST_EXPECT(result[jss::error] == "lgrNotFound");
+            BEAST_EXPECT(result[jss::error_code] == RpcLgrNotFound);
+        }
+    }
+
+    void
+    testBadKeys(unsigned apiVersion)
+    {
+        testcase("Bad keys, api " + std::to_string(apiVersion));
+        using namespace jtx;
+        Env env{*this};
+
+        auto const key = to_string(keylet::feeSettings().key);
+        auto const check = [&](json::Value const& keys, std::string const& message) {
+            json::Value params;
+            if (!keys.isNull())
+                params[jss::keys] = keys;
+            expectError(
+                *this,
+                stateProof(env, apiVersion, params),
+                "invalidParams",
+                RpcInvalidParams,
+                message);
+        };
+
+        check(json::Value{}, "Missing field 'keys'.");
+        check(key, "Invalid field 'keys', not non-empty array.");
+        check(json::Value{json::ValueType::Array}, "Invalid field 'keys', not non-empty array.");
+
+        json::Value tooMany{json::ValueType::Array};
+        for (std::uint32_t i = 0; i < 33; ++i)
+            tooMany.append(to_string(sha512Half(i)));
+        check(tooMany, "Invalid field 'keys', not array too long.");
+
+        json::Value twice{json::ValueType::Array};
+        twice.append(key);
+        twice.append(key);
+        check(twice, "Invalid field 'keys', not array of distinct keys.");
+
+        for (auto const& bad : {json::Value{key.substr(1)}, json::Value{"zz"}, json::Value{7}})
+        {
+            json::Value keys{json::ValueType::Array};
+            keys.append(bad);
+            check(keys, "Invalid field 'keys', not array of hex strings.");
+        }
+
+        // The most keys a request may name.
+        json::Value most{json::ValueType::Array};
+        for (std::uint32_t i = 0; i < 32; ++i)
+            most.append(to_string(sha512Half(i)));
+        json::Value params;
+        params[jss::keys] = most;
+        auto const result = stateProof(env, apiVersion, params);
+        BEAST_EXPECT(result[jss::status] == "success");
+        BEAST_EXPECT(result[jss::entries].size() == 32);
+    }
+
+public:
+    void
+    run() override
+    {
+        forAllApiVersions([this](unsigned apiVersion) {
+            testPresent(apiVersion);
+            testAbsent(apiVersion);
+            testLedgers(apiVersion);
+            testBadKeys(apiVersion);
+        });
+    }
+};
