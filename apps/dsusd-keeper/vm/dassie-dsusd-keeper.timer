# Starts the DSUSD keeper (dassie-dsusd-keeper.service) whenever it is not
# running: at boot, and a few seconds after each of its processes ended,
# after its hour or a failure, so that it follows the pool all the time
# from the newest `main`.
[Unit]
Description=Dassie DSUSD keeper, started again whenever it ended

[Timer]
OnBootSec=2min
OnUnitInactiveSec=10s
AccuracySec=1s

[Install]
WantedBy=timers.target
