# Updates Dassie on the market maker's VM (spec/areas/market-maker-vm.md)
# when dassie-mm-update.timer says so: `dassie update --unit` for the
# node, which restarts it and the market maker on the new version, or goes
# back to the old one if the node does not come up (update.sh).
#
# It runs as root: it writes /opt/dassie, puts back the node's database in
# /var/lib/dassie-mm if a rollback must, and restarts the units.
[Unit]
Description=Dassie market maker's updater
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30min
# Where update-before-unit.sh sends the units a release brings, where
# nothing reads them.
StateDirectory=dassie-mm-update
ExecStart=/bin/sh /opt/dassie-mm/repo/apps/market-maker/vm/update.sh
StandardOutput=journal+console
StandardError=journal+console

ProtectSystem=strict
ReadWritePaths=/opt/dassie /var/lib/dassie-mm
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
