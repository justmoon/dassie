# The market maker (spec/areas/market-maker-vm.md), on its VM, which
# startup.sh installs: `dassie market-maker` with its node,
# dassie-mm-node. Starting it starts the node first, and stopping or
# restarting the node stops or restarts it too. A node that fails to start
# does not keep it down for good: it starts all the same, `dassie setup`
# fails while the node does not answer, and it tries again until the node
# is up.
#
# Before it starts, root reads the node's passphrase from Secret Manager
# into this unit's runtime directory (phrase.sh): a file on tmpfs, readable
# by dassie-mm alone, gone when the unit stops. Then run.sh, as dassie-mm,
# sets the node up from its phrase, writes the config beside it and runs
# the market maker.
[Unit]
Description=Dassie market maker
Documentation=https://dassie.land
Wants=dassie-mm-node.service
PartOf=dassie-mm-node.service
After=dassie-mm-node.service
Wants=network-online.target
After=network-online.target
# It reads the phrases only once the clock is synced: no one is here to
# set it, and a phrase is refused while it says it was made more than a
# day after the clock (spec/decisions/phrase-format.md). startup.sh enables
# the service that holds time-sync.target back until then.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=exec
# The strategy's settings, which startup.sh writes from the instance
# metadata.
EnvironmentFile=/etc/dassie-mm/settings.env
User=dassie-mm
Group=dassie-mm
RuntimeDirectory=dassie-mm
RuntimeDirectoryMode=0700
ExecStartPre=+/bin/sh /opt/dassie-mm/repo/apps/market-maker/vm/phrase.sh
ExecStart=/bin/sh /opt/dassie-mm/repo/apps/market-maker/vm/run.sh
# It exits at start if anything it needs is missing, such as a node that
# has no account on its ledger yet, and rides out outages once it runs,
# until SIGTERM. It starts again after a failure, slowly enough that the
# node and the ledger are not asked in a hurry.
Restart=on-failure
RestartSec=30
# Each decision's line, on the serial console too, which needs no SSH.
StandardOutput=journal+console
StandardError=journal+console

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
UMask=0077

[Install]
WantedBy=multi-user.target
