{
  "name": "@dassie/website",
  "version": "0.0.0",
  "exports": {},
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2.16.0",
    "@solidjs/vite-plugin": "npm:@solidjs/vite-plugin@3.0.0-next.44",
    "@solidjs/web": "npm:@solidjs/web@2.0.0-rc.9",
    "@std/assert": "jsr:@std/assert@^1",
    "solid-js": "npm:solid-js@2.0.0-rc.9",
    "vite": "npm:vite@8.3.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@solidjs/web",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "tasks": {
    "build": "vite build --configLoader native",
    "dev": "vite build --configLoader native --watch",
    "preview": "vite preview --configLoader native"
  }
